# Copie para .env e ajuste. Em dev, sqlite ja funciona sem Postgres.
DATABASE_URL=sqlite:///./efraim_dev.db
# DATABASE_URL=postgresql+psycopg://efraim:efraim@localhost:5432/efraim

# fonte de dados: fake (default, sem rede), apify ou brightdata
EFRAIM_FONTE=fake

# Apify — so' precisa do token (sem CLI). https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
APIFY_ACTOR_MERCADOLIVRE=gio21/mercado-livre-scraper
APIFY_ACTOR_EBAY=piotrv1001/ebay-listings-scraper
APIFY_ACTOR_AMAZON=truefetch/amazon-price-tracker
APIFY_ACTOR_GOOGLE_MAPS=compass/crawler-google-places
APIFY_ACTOR_GOOGLE_SEARCH=apify/google-search-scraper
APIFY_TIMEOUT_S=120

BRIGHTDATA_API_KEY=
# Web Unlocker API — fonte do Bloco B (regional), ver
# app/sourcing/adapters/brightdata_unlocker.py. Console: https://brightdata.com/cp/zones
BRIGHTDATA_WEB_UNLOCKER_ZONE=
BRIGHTDATA_WEB_UNLOCKER_TOKEN=
# SERP API — reservado, zona ainda nao provisionada em nenhuma conta testada
# (ver nota em .env). Nao integrado no codigo.
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_SERP_TOKEN=

# WhatsApp (Etapa 7) — wa.me nao precisa; Cloud API precisa destes
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

CONCORRENCIA=5
# Bloco B faz polling de um job assincrono na Bright Data (ate 600s) - este
# timeout precisa ser maior que isso, ver app/sourcing/adapters/
# brightdata_unlocker.py (POLL_TIMEOUT_S).
TIMEOUT_FONTE_S=700

# Custo/qualidade (ver app/config.py para o raciocinio completo)
MAX_CHAMADAS_MCP_POR_JOB=120
MAX_TENTATIVAS_RATE_LIMIT=2
BACKOFF_RATE_LIMIT_S=5
CACHE_TTL_S=900

# Fila Celery — em dev, eager=true roda sem broker real
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_EAGER=true

# Identidade (Etapa 0) — TROQUE em producao, o default so' serve pra dev/teste
JWT_SECRET_KEY=efraim-dev-somente-troque-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRA_MINUTOS=1440
