# Copie para .env e ajuste. Em dev, sqlite ja funciona sem Postgres.
DATABASE_URL=sqlite:///./efraim_dev.db
# DATABASE_URL=postgresql+psycopg://efraim:efraim@localhost:5432/efraim

# fonte de dados: fake (default, sem rede) ou brightdata
EFRAIM_FONTE=fake
BRIGHTDATA_API_KEY=

# WhatsApp (Etapa 7) — wa.me nao precisa; Cloud API precisa destes
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

CONCORRENCIA=5
TIMEOUT_FONTE_S=20

# Custo/qualidade (ver app/config.py para o raciocinio completo)
MAX_CHAMADAS_MCP_POR_JOB=120
MAX_TENTATIVAS_RATE_LIMIT=2
BACKOFF_RATE_LIMIT_S=5
CACHE_TTL_S=900

# Fila Celery — em dev, eager=true roda sem broker real
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_EAGER=true
