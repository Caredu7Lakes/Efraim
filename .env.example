# ---- Bright Data MCP (backbone de web data) ----
# URL do servidor MCP. Grupos sugeridos p/ Efraim: ecommerce, business, advanced_scraping.
BRIGHTDATA_MCP_URL=https://mcp.brightdata.com/mcp?token=SEU_TOKEN&groups=ecommerce,business,advanced_scraping&pro=1

# ---- Banco de dados ----
DATABASE_URL=postgresql+psycopg://efraim:efraim@localhost:5432/efraim

# ---- Cache (opcional; sem isto usa cache em memoria) ----
REDIS_URL=redis://localhost:6379/0

# ---- WhatsApp (Etapa 7; opcional) ----
# Sem estes secrets, o NotificationPort cai para link wa.me (sem aprovacao Meta).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- App ----
EFRAIM_ENV=dev
EFRAIM_USAR_FAKES=1
